APP_IMAGE=production-platform-api:step-6
APP_ENV=production
APP_VERSION=step-6
GATEWAY_PORT=8090
GATEWAY_HTTPS_PORT=9443
TLS_CERT_FILE=./tls/production/production.crt
TLS_KEY_FILE=./tls/production/production.key
NETWORK_NAME=platform-production-network
POSTGRES_VOLUME_NAME=platform-production-postgres-data
MINIO_VOLUME_NAME=platform-production-minio-data
RABBITMQ_VOLUME_NAME=platform-production-rabbitmq-data

POSTGRES_USER=platform
POSTGRES_DB=platform
POSTGRES_PASSWORD_SECRET_FILE=./secrets/production/postgres-password

RABBITMQ_USER=platform
RABBITMQ_PASSWORD_SECRET_FILE=./secrets/production/rabbitmq-password

MINIO_ROOT_USER_SECRET_FILE=./secrets/production/minio-root-user
MINIO_ROOT_PASSWORD_SECRET_FILE=./secrets/production/minio-root-password
S3_REGION=us-east-1
S3_BUCKET=platform-files

WORKER_DELAY_MS=3000
