APP_IMAGE=production-platform-api:step-6
APP_ENV=staging
APP_VERSION=step-6
GATEWAY_PORT=8080
GATEWAY_HTTPS_PORT=8443
TLS_CERT_FILE=./tls/staging/staging.crt
TLS_KEY_FILE=./tls/staging/staging.key
NETWORK_NAME=platform-staging-network
POSTGRES_VOLUME_NAME=platform-staging-postgres-data
MINIO_VOLUME_NAME=platform-staging-minio-data
RABBITMQ_VOLUME_NAME=platform-staging-rabbitmq-data

POSTGRES_USER=platform
POSTGRES_DB=platform
POSTGRES_PASSWORD_SECRET_FILE=./secrets/staging/postgres-password

RABBITMQ_USER=platform
RABBITMQ_PASSWORD_SECRET_FILE=./secrets/staging/rabbitmq-password

MINIO_ROOT_USER_SECRET_FILE=./secrets/staging/minio-root-user
MINIO_ROOT_PASSWORD_SECRET_FILE=./secrets/staging/minio-root-password
S3_REGION=us-east-1
S3_BUCKET=platform-files

WORKER_DELAY_MS=3000
