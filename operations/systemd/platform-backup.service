[Unit]
Description=Backup the staging PostgreSQL database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=BACKUP_DIRECTORY=/home/ubuntu/platform-backups
Environment=POSTGRES_CONTAINER=platform-staging-postgres-1
Environment=POSTGRES_USER=platform
Environment=POSTGRES_DATABASE=platform
Environment=RETENTION_DAYS=7
ExecStart=/home/ubuntu/platform-operations/backup-postgres.sh

[Install]
WantedBy=multi-user.target
